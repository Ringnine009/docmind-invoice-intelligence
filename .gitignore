# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Runtime data (generated) ---
data/
benchmark/results/
*.log

# --- Untracked scratch used while reproducing a defect ---
# Raw model responses, forensics dumps and one-off probes (see
# docs/upgrade-notes.md §F). Kept on disk as evidence, never committed.
.probe/

# --- Coursework source (contains real PII + hardcoded secrets) ---
_source*/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
frontend/*.js
frontend/*.d.ts
frontend/*.tsbuildinfo

# --- Editor / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
