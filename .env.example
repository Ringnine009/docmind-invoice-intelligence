# ------------------------------------------------------------------
# DocMind — environment configuration (copy to `.env` and fill in)
# ------------------------------------------------------------------

# Where to load secrets from (optional; DocMind also probes `./.env`,
# `../.env` and `../../.env` automatically). Point it at your private
# file, e.g. the parent directory's shared `.env`:
# DOCMIND_ENV_FILE=../../.env

# --- DashScope (Alibaba Cloud Bailian) OpenAI-compatible endpoint ---
# Primary vision model used for structured invoice extraction. qwen-vl-plus is
# the default: in our smoke tests it extracts names/amounts/tax ids reliably,
# while qwen3.5-ocr (an OCR-layout model) returns poor structured JSON.
DOCMIND_VISION_MODEL_PRIMARY=qwen-vl-plus
# Fallback model if the primary is unavailable.
DOCMIND_VISION_MODEL_FALLBACK=qwen3.5-ocr
# Base URL of the OpenAI-compatible API (no trailing slash issues handled).
DASHSCOPE_OPENAI_COMPAT_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# API key (keep secret — never commit).
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# --- Runtime behaviour ---
# Where extracted batches are persisted (relative to repo root).
DOCMIND_DATA_DIR=data
# Max concurrent extraction jobs per batch.
DOCMIND_MAX_WORKERS=4
# Amount arithmetic tolerance (RMB) used by the audit engine.
DOCMIND_ARITH_TOLERANCE=0.02
# Allowed VAT rates (percent), comma separated.
DOCMIND_ALLOWED_TAX_RATES=0,1,3,5,6,9,13

# --- Server ---
DOCMIND_HOST=127.0.0.1
DOCMIND_PORT=8000
